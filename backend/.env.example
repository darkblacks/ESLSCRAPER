PORT=3333
ESL_BASE=https://transmassa.eslcloud.com.br
# Chave exigida no header X-API-Key (frontend e servidor que consumir a API)
API_KEY=troque-esta-chave
# Origens liberadas no CORS (separe por vírgula). Ex.: http://localhost:5173,https://seusite.netlify.app
CORS_ORIGINS=http://localhost:5173
# true = navegador invisível; false = abre o Chromium (útil para depurar o login)
HEADLESS=true
# Minutos sem uso até a sessão ESL ser encerrada
SESSION_TTL_MIN=60
# Permite gravar de verdade no ESL (commit). Deixe false até validar os dry-runs.
ALLOW_COMMIT=false
