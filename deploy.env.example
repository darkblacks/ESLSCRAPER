# ===== Copie para .env (na mesma pasta do docker-compose.yml) e preencha =====

# --- Domínio (DuckDNS) ---
# Ex.: se você criou "esl-transmassa" no duckdns.org:
DUCKDNS_SUBDOMINIO=esl-transmassa
DOMINIO=esl-transmassa.duckdns.org
# token que aparece no topo do site do DuckDNS depois de logar
DUCKDNS_TOKEN=cole-o-token-aqui

# --- Backend ---
ESL_BASE=https://transmassa.eslcloud.com.br
# senha do /admin (mín. 8 caracteres) — NÃO vai para o site, só você sabe
ADMIN_PASSWORD=troque-por-uma-senha-forte
# chave da API (mín. 16 caracteres). Pode trocar depois pelo /admin.
API_KEY=troque-por-uma-chave-longa-e-aleatoria
# endereço do site no Netlify (pode mudar depois pelo /admin). Aceita https://*.netlify.app
CORS_ORIGINS=https://SEU-SITE.netlify.app
# começa desligado; ligue pelo /admin depois de testar
ALLOW_COMMIT=false
SESSION_TTL_MIN=60
