# ===== Copie para .env (na mesma pasta do docker-compose.yml) e preencha =====
# O .env NUNCA vai para o GitHub (.gitignore).

# --- Domínio da API (HTTPS automático pelo Caddy) ---
# Sem domínio próprio: use o sslip.io com o IP do servidor (pontos viram traços):
DOMINIO=194-61-238-7.sslip.io
# Opcional — DuckDNS (só com: docker compose --profile duckdns up -d):
# DUCKDNS_SUBDOMINIO=esl-transmassa
# DUCKDNS_TOKEN=cole-o-token-aqui
# (e troque DOMINIO para esl-transmassa.duckdns.org)

# --- Backend ---
ESL_BASE=https://transmassa.eslcloud.com.br
# senha do /admin (mín. 8 caracteres) — NÃO vai para o site, só você sabe
ADMIN_PASSWORD=troque-por-uma-senha-forte
# chave da API (mín. 16 caracteres). Vai no frontend (VITE_API_KEY), portanto NÃO é segredo forte.
API_KEY=troque-por-uma-chave-longa-e-aleatoria
# endereço do site no Netlify (pode mudar depois pelo /admin)
CORS_ORIGINS=https://SEU-SITE.netlify.app
# MODO SIMULAÇÃO: false = nada é gravado no ESL. Ligue só depois de validar (pelo /admin ou aqui).
ALLOW_COMMIT=false
SESSION_TTL_MIN=60

# --- Limites (opcionais) ---
# tamanho máximo do envio (Caddy) e do JSON (Node)
MAX_UPLOAD=30MB
BODY_LIMIT=25mb
# requisições por minuto por IP / tentativas de login a cada 15 min por IP
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_LOGIN_15MIN=20
