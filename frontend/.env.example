# Variáveis do build do site (Vite). Em produção elas vêm do Netlify — veja frontend/netlify.env.example e DEPLOY.md §3.
# Tudo que começa com VITE_ vai para o JavaScript público do site: NUNCA coloque aqui senha do ESL nem ADMIN_PASSWORD.
# Local (npm run dev): copie para frontend/.env.local
VITE_API_URL=http://localhost:3333
VITE_API_KEY=troque-esta-chave
